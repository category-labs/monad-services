[Unit]
Description=Monad Archiver (monad-services)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monad
Group=monad
StateDirectory=monad-services
WorkingDirectory=/var/lib/monad-services
EnvironmentFile=-/etc/monad-services/env
Environment="RUST_LOG=debug,h2=warn,tower=warn"
ExecStart=/usr/lib/monad-services/monad-archive archive \
    --block-data-source ${BLOCK_DATA_SOURCE} \
    --fallback-block-data-source ${FALLBACK_BLOCK_DATA_SOURCE} \
    --archive-sink ${ARCHIVE_SINK} \
    --bft-block-path ${BFT_BLOCK_PATH} \
    --otel-endpoint ${OTEL_ENDPOINT} \
    --max-concurrent-blocks ${MAX_CONCURRENT_BLOCKS}
Restart=always
RestartSec=5
DeviceAllow=/dev/triedb rw
LimitNOFILE=1048576
# Hugemem configs below
LimitMEMLOCK=infinity
MemoryDenyWriteExecute=false
ProtectKernelModules=no
ProtectKernelLogs=no

[Install]
WantedBy=multi-user.target
