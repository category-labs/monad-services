[Unit]
Description=Monad Archive Checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monad
Group=monad
EnvironmentFile=-/home/monad/.env
ExecStart=/usr/local/bin/monad-archive-checker
Restart=always
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
