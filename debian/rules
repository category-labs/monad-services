#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	./debian/scripts/build-binaries

override_dh_auto_install:
	./debian/scripts/bundle-runtime-libs

override_dh_strip:
	if [ "$(STRIP_SYMBOLS)" = 1 ]; then dh_strip --no-automatic-dbgsym; fi
	find debian/monad-services/usr/lib/monad-services -type f \
		-exec patchelf --set-rpath '$$ORIGIN' {} \;
