#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	./debian/scripts/build-binaries

override_dh_auto_install:
	./debian/scripts/bundle-runtime-libs

# Ubuntu 24.04 ships Boost 1.83; rewrite the 1.90 runtime deps.
override_dh_shlibdeps:
	dh_shlibdeps
	sed -i -E 's/libboost-(context|stacktrace)1\.90\.0 \(>= 1\.90\.0\)/libboost-\11.83.0/g' \
		debian/monad-services.substvars

override_dh_makeshlibs:
	dh_makeshlibs --no-scripts

override_dh_strip:
	if [ "$(STRIP_SYMBOLS)" = 1 ]; then dh_strip --no-automatic-dbgsym; fi
	find debian/monad-services/usr/lib/monad-services -type f \
		-exec patchelf --set-rpath '$$ORIGIN' {} \;
	find debian/monad-services/usr/bin -type f -executable \
		-exec patchelf --set-rpath '$$ORIGIN/../lib/monad-services' {} \;

