#!/usr/bin/env sh
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version=${PACKAGE_VERSION:-}
output_dir=${DEB_OUTPUT_DIR:-"$root_dir/dist"}
stage_dir="$root_dir/target/debian/monad-services"

if [ -z "$version" ]; then
  sha=$(git -C "$root_dir" rev-parse --short=12 HEAD)
  timestamp=$(git -C "$root_dir" log -1 --format=%cd --date=format:%Y%m%d%H%M)
  version="0.0-${timestamp}-${sha}"
fi

case "$version" in
  *[!0-9A-Za-z.+:~\-]*) echo "Invalid Debian version: $version" >&2; exit 2 ;;
esac

if [ ! -f "$root_dir/monad-execution/CMakeLists.txt" ]; then
  echo "Initializing the pinned monad-execution submodule..." >&2
  git -C "$root_dir" submodule update --init --recursive monad-execution
fi

if [ ! -f "$root_dir/monad-execution/CMakeLists.txt" ]; then
  echo "monad-execution was not initialized successfully" >&2
  exit 2
fi

cd "$root_dir"
cargo build --locked --release --package monad-archive --bins

rm -rf "$stage_dir"
mkdir -p "$stage_dir/DEBIAN" "$stage_dir/usr/local/bin" "$stage_dir/usr/local/lib"
cp -a debian/. "$stage_dir/"

for binary in monad-archiver monad-archive-checker monad-indexer monad-block-writer; do
  install -m 0755 "target/release/$binary" "$stage_dir/usr/local/bin/$binary"
done

# monad-triedb and its execution bindings are built by Cargo build scripts. Keep
# their complete shared-library closure with the services, as the existing BFT
# package does, rather than relying on an undeclared host installation.
find target/release/build \( -type f -o -type l \) -name '*.so*' \
  -exec cp -a {} "$stage_dir/usr/local/lib/" \;

# Follow the same staging model as monad-integration's runtime image: resolve
# the binaries' complete non-glibc shared-library closure and copy it by SONAME.
# Core runtime libraries stay normal package dependencies.
dependency_list="$root_dir/target/debian/runtime-libraries"
: > "$dependency_list"
for binary in "$stage_dir"/usr/local/bin/*; do
  LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$binary" \
    | awk '$2 == "=>" && $3 ~ /^\// { print $1, $3 }' >> "$dependency_list"
done

sort -u "$dependency_list" | while read -r soname location; do
  case "$soname" in
    ld-linux*.so*|libc.so*|libcrypto.so*|libdl.so*|libgcc_s.so*|libm.so*|\
    libpthread.so*|libresolv.so*|librt.so*|libssl.so*|libstdc++.so*|libz.so*)
      continue
      ;;
  esac
  if [ ! -e "$stage_dir/usr/local/lib/$soname" ]; then
    cp -L "$location" "$stage_dir/usr/local/lib/$soname"
  fi
done

for binary in "$stage_dir"/usr/local/bin/*; do
  if LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$binary" | grep -q 'not found'; then
    echo "Unresolved shared libraries for $binary:" >&2
    LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$binary" | grep 'not found' >&2
    exit 2
  fi
done

sed -e "s/@PACKAGE_VERSION@/$version/" debian/DEBIAN/control.in > "$stage_dir/DEBIAN/control"
rm "$stage_dir/DEBIAN/control.in"
mkdir -p "$output_dir"
dpkg-deb --root-owner-group --build "$stage_dir" "$output_dir/monad-services_${version}_amd64.deb"
